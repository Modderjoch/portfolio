---
// Swap the suffix to -256 to fall back to the smaller sheet; the component is
// resolution-agnostic (it positions the sheet in percentages), so nothing else
// needs to change. See tools/generate-face-sprite.sh for the trade-off.
import spriteImg from "../../assets/images/faces/face-sprite-13x13-512.webp";

const {
    basePath = "/images/faces/",
    debug = false,
    size = 256,
} = Astro.props;
---

<link rel="preload" as="image" href={spriteImg.src} />

<div class="mx-auto flex justify-center">
    <div
        class="relative rounded-full shadow-inner overflow-hidden"
        style={`width:${size}px; height:${size}px;`}
    >
        <div
            class="face-tracker"
            role="img"
            aria-label="A face that follows your cursor"
            data-sprite={spriteImg.src}
            data-base-path={basePath}
            style={`background-image:url("${spriteImg.src}")`}
        >
            {/* Exact full-resolution tile, layered on top once the pointer rests. */}
            <img class="face-crisp" alt="" aria-hidden="true" />
            {debug && <div class="face-debug"></div>}
        </div>
    </div>
</div>

<style>
    .face-tracker {
        position: relative;
        width: 100%;
        height: 100%;
        /* 13 tiles per axis, so one tile fills the box at 1300%. */
        background-size: 1300% 1300%;
        background-repeat: no-repeat;
        background-position: 50% 50%;
        cursor: none;
    }

    .face-crisp {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        pointer-events: none;
    }

    .face-crisp[data-visible="true"] {
        opacity: 1;
    }

    .face-debug {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 8px 12px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 12px;
        line-height: 1.4;
    }
</style>

<script>
    const P_MIN = -15;
    const P_MAX = 15;
    const STEP = 2.5;
    const COLS = 13;
    const CRISP_SIZE = 512;
    const REST_MS = 150;

    function clamp(value: number, min: number, max: number) {
        return Math.max(min, Math.min(max, value));
    }

    function quantizeToGrid(val: number) {
        const raw = P_MIN + ((val + 1) * (P_MAX - P_MIN)) / 2;
        const snapped = Math.round(raw / STEP) * STEP;
        return clamp(snapped, P_MIN, P_MAX);
    }

    function sanitize(val: number) {
        return Number(val).toFixed(1).replace("-", "m").replace(".", "p");
    }

    function gridToFilename(px: number, py: number) {
        return `gaze_px${sanitize(px)}_py${sanitize(py)}_${CRISP_SIZE}.webp`;
    }

    function initializeFaceTracker(container: HTMLElement) {
        const basePath = container.dataset.basePath || "/images/faces/";
        const debugEl = container.querySelector<HTMLElement>(".face-debug");
        const crisp = container.querySelector<HTMLImageElement>(".face-crisp");
        if (!crisp) return;

        let pointerX = 0;
        let pointerY = 0;
        let rafId = 0;
        let restTimer = 0;
        let col = -1;
        let row = -1;
        // Bumped on every pointer move so a slow crisp-tile load that lands
        // after the gaze already changed gets discarded instead of flashing.
        let crispToken = 0;

        // Until the sprite has decoded, the neutral tile stands in so the
        // circle is never empty on a slow connection.
        let spriteReady = false;
        const probe = new Image();
        probe.src = container.dataset.sprite || "";
        probe
            .decode()
            .catch(() => {})
            .finally(() => {
                spriteReady = true;
            });

        function hideCrisp() {
            crispToken++;
            window.clearTimeout(restTimer);
            // Keep the placeholder up until the sprite can take over.
            if (spriteReady) crisp!.dataset.visible = "false";
        }

        async function showCrisp(px: number, py: number) {
            const token = crispToken;
            const src = `${basePath}${gridToFilename(px, py)}`;
            const next = new Image();
            next.src = src;
            try {
                await next.decode();
            } catch {
                return;
            }
            if (token !== crispToken) return;
            crisp!.src = src;
            crisp!.dataset.visible = "true";
        }

        function apply() {
            rafId = 0;

            const nx = clamp((pointerX / window.innerWidth - 0.5) * 2, -1, 1);
            const ny = clamp((0.5 - pointerY / window.innerHeight) * 2, -1, 1);
            const px = quantizeToGrid(nx);
            const py = quantizeToGrid(ny);

            const nextCol = Math.round((px - P_MIN) / STEP);
            const nextRow = Math.round((P_MAX - py) / STEP);

            if (nextCol !== col || nextRow !== row) {
                col = nextCol;
                row = nextRow;
                container.style.backgroundPosition = `${(col / (COLS - 1)) * 100}% ${(row / (COLS - 1)) * 100}%`;

                if (debugEl) {
                    debugEl.innerHTML =
                        `Mouse: (${Math.round(pointerX)}, ${Math.round(pointerY)})<br/>` +
                        `Cell: col ${col}, row ${row}<br/>` +
                        `Tile: ${gridToFilename(px, py)}`;
                }
            }

            restTimer = window.setTimeout(() => showCrisp(px, py), REST_MS);
        }

        function onMove(x: number, y: number) {
            pointerX = x;
            pointerY = y;
            hideCrisp();
            // Coalesce every move in a frame into a single style write.
            if (!rafId) rafId = requestAnimationFrame(apply);
        }

        window.addEventListener(
            "mousemove",
            (e) => onMove(e.clientX, e.clientY),
            { passive: true },
        );
        window.addEventListener(
            "touchmove",
            (e) => {
                if (e.touches.length > 0)
                    onMove(e.touches[0].clientX, e.touches[0].clientY);
            },
            { passive: true },
        );

        // Neutral face right away, then settle on the centre of the container.
        crisp.src = `${basePath}${gridToFilename(0, 0)}`;
        crisp.dataset.visible = "true";

        const rect = container.getBoundingClientRect();
        onMove(rect.left + rect.width / 2, rect.top + rect.height / 2);
    }

    document
        .querySelectorAll<HTMLElement>(".face-tracker")
        .forEach(initializeFaceTracker);
</script>
